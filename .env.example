# Needed for the Phase 1 dark basemap; also used by later geocoding work.
MAPTILER_API_KEY=

# Add these when implementing their corresponding integrations.
OPENROUTESERVICE_API_KEY=
OPENWEATHER_API_KEY=
# Application-level One Call 4.0 requests per UTC day (may be lowered, never raised above 100).
OPENWEATHER_DAILY_REQUEST_LIMIT=100
# ECCC GeoMet SWOB regional query and validated-cache policy.
SWOB_BBOX=-123.30,49.15,-122.85,49.35
SWOB_CACHE_TTL_SECONDS=600
TRANSLINK_API_KEY=
OPENROUTER_API_KEY=

# Provisional model selected and exercised during Assignment 0D.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it

# Other source-specific cache and relevance settings are documented with their adapters.
